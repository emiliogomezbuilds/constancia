# Public values (safe in the browser). Set them in Vercel > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only secret. Never commit it. Set it ONLY in Vercel (and .env.local on your computer).
GEMINI_API_KEY=
# Optional: override the model name if Google retires the default.
GEMINI_MODEL=gemini-3.5-flash-lite
